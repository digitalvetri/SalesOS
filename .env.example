# ───────────── Required ─────────────
#
# Local development: `pnpm db:up` starts PostgreSQL on port 55433 (see
# docker-compose.dev.yml); copy this file to .env.local.
# Production (Coolify): use the PostgreSQL resource's internal URL.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/salesos
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55433/salesos

# Encryption key for secrets at rest. Generate a NEW one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=REPLACE-WITH-32-BYTE-BASE64

# Public app URL. Use https:// in production — login cookies are marked
# Secure only when this starts with https://.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────── Optional ─────────────

# Where uploaded photos are stored (default: ./.uploads locally, /app/data/uploads in Docker).
# UPLOAD_DIR=

# First start of an EMPTY production database: creates the company, KI/KFM
# billing entities and this Owner login. Remove after the first sign-in.
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_PASSWORD=
# BOOTSTRAP_OWNER_NAME=Kumar
# BOOTSTRAP_COMPANY_NAME=Kumaar Industries

# Docker image: apply migrations + extra.sql on container start.
# MIGRATE_ON_START=true

# Scripts only: temporary password for `pnpm bootstrap:auth`.
# BOOTSTRAP_PASSWORD=
