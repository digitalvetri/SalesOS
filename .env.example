# ───────────── Required ─────────────
#
# Local development: copy to .env.local after `pnpm sb:start` and paste the
# anon + service_role keys that `pnpm sb:status` prints (URLs below already
# match the local stack).
#
# Production (Vercel → Settings → Environment Variables): use the values from
# your Supabase project (region ap-south-1 / Mumbai).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key — server only, never NEXT_PUBLIC_>

# Prisma — pooled (runtime) + direct (migrations / extra.sql).
# Production (Supabase → Connect):
#   DATABASE_URL = Transaction pooler, port 6543, and append ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = Direct connection, port 5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# App-level encryption key for secrets at rest. Generate a NEW one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=REPLACE-WITH-32-BYTE-BASE64

# Public app URL (https://your-domain in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────── Scripts only (not needed on Vercel) ─────────────

# Temporary password given to users created by `pnpm bootstrap:auth`.
# BOOTSTRAP_PASSWORD=

# Login used by scripts/screenshot-tour.mjs, shot-single.mjs, verify-login.mjs.
# LOGIN_EMAIL=
# LOGIN_PASSWORD=
