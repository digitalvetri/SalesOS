# ───────────── Required for P0 ─────────────

# Supabase project (ap-south-1 per Q7)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Prisma — Supabase gives you two URLs on the "Connect" screen.
# Pooled (port 6543) for runtime, direct (port 5432) for migrations.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# App-level encryption key for secrets at rest (WhatsApp token, etc.).
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=REPLACE-WITH-32-BYTE-BASE64

# Public app URL (used in Supabase callbacks and WhatsApp webhook base).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────── Optional ─────────────

# Login rate-limit backend. If unset, uses in-memory (dev only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry (P8)
# SENTRY_DSN=
