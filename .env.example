# ───────────── Required ─────────────
#
# For **local development**, run `pnpm sb:env > .env.local` after `pnpm sb:start`.
# Supabase CLI prints these five values and they're deterministic per machine.
#
# For **production**, create a Supabase project in ap-south-1 (spec Q7) and paste its values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `pnpm sb:env`>
SUPABASE_SERVICE_ROLE_KEY=<from `pnpm sb:env`>

# Prisma — pooled (runtime) + direct (migrations).
# Local Supabase exposes both on port 54322 (same URL for dev).
# Production: Supabase "Connect" screen provides pooled (6543) + direct (5432).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# App-level encryption key for secrets at rest (WhatsApp token, etc.).
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=REPLACE-WITH-32-BYTE-BASE64

# Public app URL (used in Supabase callbacks and WhatsApp webhook base).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────── Optional ─────────────

# Login rate-limit backend. If unset, uses in-memory (dev only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry (P8)
# SENTRY_DSN=
