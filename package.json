{
  "name": "salesos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm run lint:fixtures",
    "lint:fixtures": "node scripts/check-forbidden-prisma-fixture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy && pnpm run prisma:apply-extra",
    "prisma:migrate:dev": "prisma migrate dev && pnpm run prisma:apply-extra",
    "prisma:apply-extra": "tsx prisma/apply-extra.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "pnpm run prisma:migrate && pnpm run prisma:seed",
    "sb:start": "supabase start",
    "sb:stop": "supabase stop",
    "sb:status": "supabase status",
    "sb:reset": "supabase db reset",
    "sb:env": "supabase status -o env",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^2.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prisma": "6.19.3",
    "supabase": "^2.120.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
